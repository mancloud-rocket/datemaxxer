{
  "type": "object",
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "arquetipo_detectado": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "string",
          "enum": ["viajero", "intelectual", "deportista", "creativo", "profesional", "outdoor", "social", "hogareno"]
        },
        "confianza": { "type": "number", "description": "0 a 1" }
      },
      "required": ["nombre", "confianza"],
      "additionalProperties": false
    },
    "score_coherencia": { "type": "integer", "description": "0-100, legibilidad del perfil en 200ms" },
    "lectura_200ms": { "type": "string" },
    "gap_analysis": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "objetivo": {
              "type": "string",
              "enum": ["viajero", "intelectual", "deportista", "creativo", "profesional", "outdoor", "social", "hogareno"]
            },
            "distancia": { "type": "string", "enum": ["baja", "media", "alta"] },
            "acciones": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["objetivo", "distancia", "acciones"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "plan_de_fotos": {
      "type": "object",
      "properties": {
        "conservar": { "type": "array", "items": { "type": "integer" } },
        "reemplazar": { "type": "array", "items": { "type": "integer" } },
        "orden_sugerido": { "type": "array", "items": { "type": "integer" } },
        "briefs_faltantes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tipo": { "type": "string" },
              "specs": { "type": "string" }
            },
            "required": ["tipo", "specs"],
            "additionalProperties": false
          }
        }
      },
      "required": ["conservar", "reemplazar", "orden_sugerido", "briefs_faltantes"],
      "additionalProperties": false
    },
    "quick_wins": { "type": "array", "items": { "type": "string" } },
    "indice": {
      "type": "object",
      "description": "F1b. Solo los componentes percibidos: global, bucket_global y margen los calcula el código.",
      "properties": {
        "facial": { "$ref": "#/$defs/componente" },
        "presentacion": { "$ref": "#/$defs/componente" },
        "produccion": { "$ref": "#/$defs/componente" },
        "limitantes": {
          "type": "array",
          "description": "Qué impidió afinar el juicio: pocas fotos, un solo ángulo, filtros, sin cuerpo entero.",
          "items": { "type": "string" }
        }
      },
      "required": ["facial", "presentacion", "produccion", "limitantes"],
      "additionalProperties": false
    }
  },
  "required": ["version", "arquetipo_detectado", "score_coherencia", "lectura_200ms", "gap_analysis", "plan_de_fotos", "quick_wins", "indice"],
  "additionalProperties": false,
  "$defs": {
    "componente": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string",
              "enum": ["bajo", "medio_bajo", "medio", "alto", "muy_alto", "top"],
              "description": "Elegí el bucket ANTES que el score. bajo=p0-20, medio_bajo=p20-40, medio=p40-60, alto=p60-80, muy_alto=p80-95, top=p95-100"
            },
            "score": {
              "type": "integer",
              "description": "Tiene que caer dentro del rango de su bucket: bajo 0-19, medio_bajo 20-39, medio 40-59, alto 60-79, muy_alto 80-94, top 95-100"
            },
            "evidencia": { "type": "array", "items": { "type": "string" } },
            "ancla": {
              "type": "object",
              "description": "Obligatorio. Es el mecanismo que evita que todo termine en medio/alto.",
              "properties": {
                "un_bucket_arriba": { "type": "string" },
                "un_bucket_abajo": { "type": "string" }
              },
              "required": ["un_bucket_arriba", "un_bucket_abajo"],
              "additionalProperties": false
            },
            "confianza": { "type": "number", "description": "0 a 1" }
          },
          "required": ["bucket", "score", "evidencia", "ancla", "confianza"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    }
  }
}
