{
  "redirects": [
    { "source": "/", "destination": "/cinema.html", "permanent": false },

    { "source": "/app", "destination": "https://datemaxxer-app.vercel.app/app", "permanent": false },
    { "source": "/app/:path*", "destination": "https://datemaxxer-app.vercel.app/app/:path*", "permanent": false },
    { "source": "/auditoria", "destination": "https://datemaxxer-app.vercel.app/app", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/frames/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
