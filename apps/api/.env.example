# Copiar a .env y completar. La API valida esto al arrancar (src/env.ts).
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Motores de IA (Claude API)
ANTHROPIC_API_KEY=sk-ant-api03-...
# AUDIT_MODEL=claude-opus-4-8   # opcional, default claude-opus-4-8

# Verificación de JWT: con SUPABASE_URL usa el JWKS del proyecto (recomendado).
# SUPABASE_JWT_SECRET (legacy HS256) solo como alternativa.
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=

RATE_LIMIT_MAX=100
